# mock: serve contract fixtures (no database needed)
# live: database-backed service; unimplemented domain routes return 501 not_implemented
API_MODE=mock
PORT=8787
# Comma-separated browser origins allowed by CORS. In mock mode, http://localhost:* and http://127.0.0.1:* are also allowed.
CORS_ORIGINS=
# Required in live mode. Example for the local Postgres used in development:
# DATABASE_URL=postgres://livingin:livingin@127.0.0.1:5432/livingin
DATABASE_URL=
