      "headers": {
        "ETag": "\"1\""
      },
      "body": {
        "id": "apl_01JA0000000000000000003005",
        "revision": 1,
        "job_id": "job_01JA0000000000000000003004",
        "job_snapshot": {
          "title": "Care worker (介護職員) at a residential care home",
          "employer_name": "Example Hikari Care Home (example)",
          "url": null,
          "captured_at": "2026-10-15T09:00:00Z"
        },
        "stage": "saved",
        "stage_history": [
          {
            "set_by": "member",
            "stage": "saved",
            "at": "2026-10-15T09:00:00Z"
          }
        ],
        "next_action": {
          "description": "Read the employer’s page about support for care qualifications.",
          "due_on": null
        },
        "notes": "",
