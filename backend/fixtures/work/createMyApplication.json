        "updated_at": "2026-10-15T09:00:00Z"
      }
    },
    "validation_failed": {
      "summary": "No job_id and no title/employer_name; malformed due date",
      "status": 400,
      "body": {
        "type": "urn:livingin:problem:validation_failed",
        "title": "Validation failed",
        "status": 400,
        "code": "validation_failed",
        "request_id": "fixture",
        "retryable": false,
        "fields": [
          {
            "pointer": "/body/title",
            "code": "custom",
            "message": "Give a job_id, or a title and employer_name for a job found elsewhere"
          },
          {
            "pointer": "/body/next_action/due_on",
            "code": "invalid_format",
            "message": "Invalid ISO date"
          }
        ]
      }
    },
    "unknown_job": {
      "summary": "job_id does not name a job",
      "status": 400,
      "body": {
        "type": "urn:livingin:problem:validation_failed",
        "title": "Validation failed",
        "status": 400,
        "code": "validation_failed",
        "request_id": "fixture",
        "retryable": false,
        "fields": [
          {
            "pointer": "/body/job_id",
            "code": "unknown_job",
            "message": "No job with this ID. To track a job found elsewhere, omit job_id and give a title and employer name."
          }
        ]
      }
    },
    "already_tracked": {
      "summary": "Member already tracks this job",
      "status": 409,
      "body": {
        "type": "urn:livingin:problem:conflict",
        "title": "Conflict",
        "status": 409,
