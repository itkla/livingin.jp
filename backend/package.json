{
  "name": "@livingin/backend",
  "version": "0.1.0",
  "private": true,
  "description": "livingin.jp backend: API contract, contract fixtures, mock server and service skeleton",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "start:mock": "API_MODE=mock tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "contract:generate": "tsx scripts/generate-openapi.ts",
    "contract:check": "tsx scripts/check-contract.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts up",
    "db:rollback": "tsx --env-file-if-exists=.env scripts/migrate.ts down",
    "db:status": "tsx --env-file-if-exists=.env scripts/migrate.ts status",
    "check": "npm run typecheck && npm test && npm run contract:check"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "hono": "4.13.11",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
